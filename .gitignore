# Dependencies
node_modules/
.venv/

# Build output
dist/

# Polycam raw captures and the ABO metadata cache: large, and re-creatable
data/scans/*/raw/
# Splat PLYs (Polycam export, SuperSplat output): only the compressed splat.spz is committed
data/scans/*/*.ply
# ...except the raw exports kept as source material in real-scans/, which Git LFS stores
!data/scans/real-scans/*.ply
scripts/.cache/

# Text-to-3D (server/generate-object): its items are committed like the Catalog's, as each was paid for. Not the
# sandbox's stand-ins, or fal's original outputs (data/catalog/raw), which stay on the machine that made them.
data/catalog/generated-sandbox.json
data/catalog/models/gen_sandbox_*
data/catalog/thumbs/gen_sandbox_*
data/catalog/raw/

# Local env files (.superset/setup.sh copies these into new workspaces)
.env
.env.*
!.env.example

# Personal Superset overrides
.superset/config.local.json

# macOS
.DS_Store
scripts/scan-renders/scan-renders/
